        <UserObject label="" mermaidData="{&#10;  &quot;data&quot;: &quot;classDiagram\n    class Patient {\n        -String name\n        -int age\n        -String dob\n        -int condition\n        -int arrivalTick\n        -int deadline\n        +getDob() String\n        +getCondition() int\n        +escalate() void\n    }\n\n    class Doctor {\n        -String name\n        -int age\n        -String dob\n        -int skill\n        -int shiftStart\n        -int shiftEnd\n        -Patient current\n        -int busyUntil\n        +isOnShift(int tick) boolean\n        +isFree(int tick) boolean\n        +treat(Patient p, int tick) void\n    }\n\n    class BTree~V~ {\n        -Node root\n        -int t\n        +BTree(int t)\n        +insert(String key, V value) void\n        +search(String key) V\n        -splitChild(Node parent, int i) void\n        -insertNonFull(Node n, String key, V value) void\n    }\n\n    class Node~V~ {\n        -List~String~ keys\n        -List~V~ values\n        -List~Node~ children\n        -boolean leaf\n    }\n\n    class Simulation {\n        -int tick\n        -BTree~Patient~ patients\n        -BTree~Doctor~ doctors\n        -List~Doctor~ doctorList\n        -List~Patient~ pending\n        -PriorityQueue~Patient~ waiting\n        +loadData(String patientCsv, String doctorCsv) void\n        +nextTick() void\n        +findPatient(String dob) Patient\n        +findDoctor(String dob) Doctor\n        +getWaiting() List~Patient~\n        +getDoctors() List~Doctor~\n    }\n\n    class App {\n        -Simulation sim\n        -ListView waitingView\n        -ListView doctorView\n        -TextField lookupField\n        +start(Stage stage) void\n        -refresh() void\n    }\n\n    Simulation \&quot;1\&quot; *-- \&quot;2\&quot; BTree : stores\n    BTree \&quot;1\&quot; *-- \&quot;1\&quot; Node : root\n    Node \&quot;1\&quot; o-- \&quot;0..*\&quot; Node : children\n    Simulation \&quot;1\&quot; o-- \&quot;0..*\&quot; Patient : queues\n    Simulation \&quot;1\&quot; o-- \&quot;1..*\&quot; Doctor : schedules\n    Doctor \&quot;1\&quot; --&gt; \&quot;0..1\&quot; Patient : treats\n    App \&quot;1\&quot; --&gt; \&quot;1\&quot; Simulation : drives&quot;,&#10;  &quot;config&quot;: null,&#10;  &quot;version&quot;: &quot;12&quot;&#10;}" id="iGXykX6K76vcyWMJ6gMk-1">
